<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sentryScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingHorizontal="@dimen/readme_padding_horizontal"
    android:paddingTop="36dp"
    android:paddingBottom="48dp"
    android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/field_min_height"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sentry_enabled"
                android:textColor="@color/readme_text"
                android:textSize="@dimen/field_text_size" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sentryEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:thumbTint="@color/line"
                android:trackTint="@color/line" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="@dimen/field_min_height"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="@string/sentry_delete_after_send"
                android:textColor="@color/readme_text"
                android:textSize="@dimen/field_text_size" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/sentryDeleteAfterSend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:thumbTint="@color/line"
                android:trackTint="@color/line" />
        </LinearLayout>

        <TextView
            android:id="@+id/sentryLastScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif"
            android:text="@string/sentry_last_scan_never"
            android:textColor="@color/menu_header_version"
            android:textSize="@dimen/field_label_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sentry_bot_token"
            android:textColor="@color/line"
            android:textSize="@dimen/field_label_size" />

        <EditText
            android:id="@+id/sentryBotToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:background="@drawable/edit_field_background"
            android:fontFamily="sans-serif"
            android:hint="@string/sentry_bot_token_hint"
            android:importantForAutofill="no"
            android:inputType="textVisiblePassword"
            android:minHeight="@dimen/field_min_height"
            android:paddingHorizontal="16dp"
            android:textColor="@color/readme_text"
            android:textColorHint="@color/field_hint"
            android:textSize="@dimen/field_text_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sentry_link"
            android:textColor="@color/line"
            android:textSize="@dimen/field_label_size" />

        <EditText
            android:id="@+id/sentryLink"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="username"
            android:background="@drawable/edit_field_background"
            android:fontFamily="sans-serif"
            android:hint="@string/sentry_link_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:minHeight="@dimen/field_min_height"
            android:paddingHorizontal="16dp"
            android:textColor="@color/readme_text"
            android:textColorHint="@color/field_hint"
            android:textSize="@dimen/field_text_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sentry_folder"
            android:textColor="@color/line"
            android:textSize="@dimen/field_label_size" />

        <EditText
            android:id="@+id/sentryFolder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:autofillHints="postalAddress"
            android:background="@drawable/edit_field_background"
            android:fontFamily="sans-serif"
            android:hint="@string/sentry_folder_hint"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:minHeight="@dimen/field_min_height"
            android:paddingHorizontal="16dp"
            android:textColor="@color/readme_text"
            android:textColorHint="@color/field_hint"
            android:textSize="@dimen/field_text_size" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/sentry_interval"
            android:textColor="@color/line"
            android:textSize="@dimen/field_label_size" />

        <EditText
            android:id="@+id/sentryInterval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/edit_field_background"
            android:fontFamily="sans-serif"
            android:hint="@string/sentry_interval_default"
            android:importantForAutofill="no"
            android:inputType="number"
            android:minHeight="@dimen/field_min_height"
            android:paddingHorizontal="16dp"
            android:text="@string/sentry_interval_default"
            android:textColor="@color/readme_text"
            android:textColorHint="@color/field_hint"
            android:textSize="@dimen/field_text_size" />

        <TextView
            android:id="@+id/sentryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.2"
            android:text="@string/sentry_status_idle"
            android:textColor="@color/menu_header_version"
            android:textSize="@dimen/field_label_size" />

        <TextView
            android:id="@+id/sentryDownloadLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/edit_field_background"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="@dimen/field_min_height"
            android:paddingHorizontal="24dp"
            android:text="@string/sentry_download_log"
            android:textColor="@color/readme_text"
            android:textSize="@dimen/field_text_size" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
