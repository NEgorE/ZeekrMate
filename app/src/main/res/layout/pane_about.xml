<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readmeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fadeScrollbars="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:paddingBottom="24dp"
    android:scrollbarStyle="insideOverlay"
    android:scrollbarThumbVertical="@drawable/scrollbar_thumb"
    android:scrollbars="vertical"
    android:visibility="gone">

    <TextView
        android:id="@+id/readmeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.01"
        android:lineSpacingMultiplier="1.28"
        android:paddingHorizontal="@dimen/readme_padding_horizontal"
        android:paddingTop="36dp"
        android:paddingBottom="48dp"
        android:textColor="@color/readme_text"
        android:textColorLink="@color/line"
        android:textIsSelectable="false"
        android:textSize="@dimen/readme_body_size" />
</androidx.core.widget.NestedScrollView>
